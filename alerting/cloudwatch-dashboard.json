        "metrics": [
          [
            "ToDoListApi",
            "LatenciaMs",
            {
              "label": "Promedio",
              "stat": "Average"
            }
          ],
          [
            "ToDoListApi",
            "LatenciaMs",
            {
              "label": "Máximo",
              "stat": "Maximum"
            }
          ]
        ],
        "period": 60,
        "region": "us-east-1",
        "title": "Latencia de la API (ms)",
