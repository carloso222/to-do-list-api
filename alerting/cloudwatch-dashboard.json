{
  "widgets": [
    {
      "height": 3,
      "properties": {
        "alarms": [
          "arn:aws:cloudwatch:us-east-1:342058290607:alarm:to-do-list-api-ec2-cpu-alta",
          "arn:aws:cloudwatch:us-east-1:342058290607:alarm:to-do-list-api-errores-bd",
          "arn:aws:cloudwatch:us-east-1:342058290607:alarm:to-do-list-api-tasa-errores-5xx",
          "arn:aws:cloudwatch:us-east-1:342058290607:alarm:to-do-list-api-latencia-alta"
        ],
        "title": "Estado de las alarmas"
      },
      "type": "alarm",
      "width": 24,
      "x": 0,
      "y": 0
    },
    {
      "height": 6,
      "properties": {
        "metrics": [
          [
            "ToDoListApi",
            "Requests",
            {
              "label": "Requests"
            }
          ],
          [
            "ToDoListApi",
            "Errores5xx",
            {
              "color": "#d62728",
              "label": "Errores 5xx"
            }
          ]
        ],
        "period": 60,
        "region": "us-east-1",
        "stat": "Sum",
        "title": "Requests y errores 5xx (por minuto)",
        "view": "timeSeries"
      },
      "type": "metric",
      "width": 12,
      "x": 0,
      "y": 3
    },
    {
      "height": 6,
      "properties": {
        "annotations": {
          "horizontal": [
            {
              "label": "Umbral de alarma (10%)",
              "value": 10
            }
          ]
        },
        "metrics": [
          [
            {
              "expression": "IF(r >= 5, 100 * e / r, 0)",
              "id": "tasa",
              "label": "Tasa de errores %"
            }
          ],
          [
            "ToDoListApi",
            "Requests",
            {
              "id": "r",
              "stat": "Sum",
              "visible": false
            }
          ],
          [
            "ToDoListApi",
            "Errores5xx",
            {
              "id": "e",
              "stat": "Sum",
              "visible": false
            }
          ]
        ],
        "period": 300,
        "region": "us-east-1",
        "title": "Tasa de errores 5xx (%)",
        "view": "timeSeries",
        "yAxis": {
          "left": {
            "min": 0
          }
        }
      },
      "type": "metric",
      "width": 12,
      "x": 12,
      "y": 3
